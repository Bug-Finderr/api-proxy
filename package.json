{
  "name": "api-proxy",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.5.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:compat": "vitest run --config vitest.compat.config.ts",
    "test:py": "node test/run-py.mjs",
    "test": "nub run test:unit && nub run test:compat && nub run test:py",
    "lint": "tsc --noEmit && biome check --write --unsafe .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.20",
    "@ai-sdk/google": "^4.0.24",
    "@ai-sdk/openai": "^4.0.20",
    "@anthropic-ai/sdk": "^0.115.0",
    "@biomejs/biome": "^2.5.5",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@genkit-ai/google-genai": "^1.40.1",
    "@google/genai": "^2.13.0",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.3",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/openai": "^1.5.5",
    "@types/ws": "^8.18.1",
    "ai": "^7.0.37",
    "genkit": "^1.40.1",
    "lefthook": "^2.1.10",
    "openai": "^6.49.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "hono": "^4.12.32"
  },
  "packageManager": "nub@0.5.0"
}
